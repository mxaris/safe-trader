# Only needed for mode: live. Create keys with TRADE permission only — never enable withdrawals.
SAFE_TRADER_API_KEY=
SAFE_TRADER_API_SECRET=
# Some exchanges (e.g. OKX, KuCoin) also require a passphrase.
SAFE_TRADER_API_PASSWORD=

# Coinbase (CDP API key): the key is the "name" (organizations/.../apiKeys/...) and the
# secret is the EC private key. Put it on one line with \n for line breaks, in quotes:
# SAFE_TRADER_API_KEY=organizations/xxxx/apiKeys/yyyy
# SAFE_TRADER_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nMHcC...\n-----END EC PRIVATE KEY-----\n"
